# Your Supabase project credentials
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Gemini API key (primary AI provider)
# Get one at: https://aistudio.google.com/app/apikey
# Keys start with AQ. or AIza
VITE_GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY=your_gemini_api_key

# Optional: OpenRouter (fallback if no Gemini key). Keys start with sk-or-
# VITE_OPENROUTER_API_KEY=sk-or-v1-...

# Optional: OpenAI (fallback). Keys start with sk- or sk-proj-
# VITE_OPENAI_API_KEY=sk-proj-...

# GitHub PAT for private repo access (set per-user in Settings, not required here)
# GITHUB_TOKEN=ghp_...
